# OA Platform 本地基建端口。全部变量化 —— auth/risk/workflow 都踩过 docker-proxy 残留占端口的坑。
# 用法：cp .env.example .env 后按需改。

OA_PG_HOST_PORT=35432
OA_PG_DB=oa
OA_PG_USER=oa
OA_PG_PASSWORD=oa_dev_pwd

OA_REDIS_HOST_PORT=36379

OA_KAFKA_HOST_PORT=39092

OA_MINIO_API_PORT=39000
OA_MINIO_CONSOLE_PORT=39001
OA_MINIO_ROOT_USER=oaminio
OA_MINIO_ROOT_PASSWORD=oaminio_dev_pwd

# ── 应用（--profile apps 起全栈时用） ──────────────────────────
OA_IMAGE_TAG=local
OA_APP_PORT=8400
OA_NOTIFY_PORT=8401
OA_FILE_PORT=8402
OA_JOB_PORT=8403
OA_CONSOLE_PORT=8404
OA_MOBILE_PORT=8405

# ★ 生产必须注入：openssl rand -base64 32
#   留空则使用仓库里写死的开发默认密钥，敏感字段等于没加密
OA_CRYPTO_DATA_KEY=

# 接口权限总开关。关掉等于拆掉系统唯一的安全边界，只在联调期短暂使用
OA_IAM_ENFORCE=true
# 初始管理员（Casdoor sub）。首次部署后应清空
OA_BOOTSTRAP_ADMIN=
# 万人级装载接口，生产必须为 false
OA_ORG_SEED_ENABLED=false
# REMOTE = 接 workflow-platform :8300；LOCAL = 本地测试替身
OA_WORKFLOW_MODE=REMOTE

# 生产默认 JWT；只有本地冒烟脚本应显式改为 DEV。
OA_SECURITY_MODE=JWT
OA_JWT_JWKS=http://host.docker.internal:8000/.well-known/jwks
OA_JWT_ISSUER=http://localhost:8000
# 必填，必须与 Casdoor access_token 的 aud 一致；本地 provision 脚本默认 oa-platform-local
OA_JWT_AUDIENCE=oa-platform-local
OA_NOTIFY_WS_TICKET_TTL=30

# PC / 移动端静态构建参数（deploy/build-images.sh 读取）
VITE_AUTH_ENABLED=true
VITE_CASDOOR_AUTHORITY=http://localhost:8000
VITE_CASDOOR_CLIENT_ID=oa-platform-local
VITE_OIDC_SCOPE=openid profile email offline_access
VITE_WS_PATH=/ws
