# Java / Maven 构建产物与诊断文件
target/
*.class
*.jar
*.war
*.ear
# 若使用 Maven Wrapper，启动所需的 wrapper jar 必须可提交
!.mvn/wrapper/maven-wrapper.jar
dependency-reduced-pom.xml
.flattened-pom.xml
pom.xml.versionsBackup
pom.xml.releaseBackup
pom.xml.next
release.properties
.mvn/timing.properties
.mvn/.develocity/
*.hprof
*.jfr
.jqwik-database
hs_err_pid*
replay_pid*

# IDE 本机配置；共享运行配置（如 .run/）继续提交
.idea/
*.iml
*.ipr
*.iws
out/
.classpath
.project
.settings/
.factorypath
.vscode/

# Node / Vite 依赖、构建缓存与测试报告；锁文件继续提交
node_modules/
dist/
.pnpm-store/
.vite/
.vite-temp/
*.tsbuildinfo
.eslintcache
.stylelintcache
coverage/
.nyc_output/
playwright-report/
blob-report/
test-results/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python 测试及部署工具的本地缓存、虚拟环境
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# 本地环境变量；示例和模板必须可提交，不忽略全部 *.env / *.properties
.env
.env.*
*.env.local
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

# 私密运行配置、阶段测试证据、临时导出统一放根目录 .local/ 或 tmp/
/.local/
/tmp/
/temp/
/.ci-deps/
logs/
*.log
*.log.*
*.pid
*.pid.lock
*.tmp

# 本机 Agent 设置；共享工程说明、设计与交付文档继续提交
.claude/settings.local.json
/.codex/tasks/

# 操作系统与编辑器临时文件
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
