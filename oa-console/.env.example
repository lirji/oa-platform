# 留空 = 相对路径（dev 走 vite proxy / prod 走 nginx 同源反代）。
# ★ 不要填成 http://localhost:8400 —— 后端的 CORS 虽然配了本机来源，
#   但同源反代才是主路径，跨源只是兜底。
VITE_API_BASE_URL=

# 鉴权分期：先 false 用 X-OA-User 直连 DEV 后端联调，Casdoor 就绪后改 true
VITE_AUTH_ENABLED=false
VITE_DEV_USER=seed-user-1

# Casdoor（VITE_AUTH_ENABLED=true 时才用）。★ authority 直连 :8000，不代理
VITE_CASDOOR_AUTHORITY=http://localhost:8000
VITE_CASDOOR_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email

VITE_WS_PATH=/ws

# ── 以下仅 dev proxy 用，不会进构建产物 ──
VITE_API_TARGET=http://localhost:8400
VITE_NOTIFY_TARGET=http://localhost:8401
VITE_FILE_TARGET=http://localhost:8402
VITE_JOB_TARGET=http://localhost:8403
