<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.lrj.oa</groupId>
    <artifactId>oa-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>oa-common</artifactId>
  <name>oa-common</name>
  <description>通用基础：Result/异常/工具/TenantContext/号段生成器/审计基础设施</description>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <!-- 可选：装了 Redis 的部署单元自动获得跨节点缓存失效总线 -->
    <dependency>
      <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-redis</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- jsonb TypeHandler 需要 PGobject -->
    <dependency>
      <groupId>org.postgresql</groupId><artifactId>postgresql</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- 可选：装了 MyBatis-Plus 的部署单元自动获得统一的分页/乐观锁拦截器配置 -->
    <dependency>
      <groupId>com.baomidou</groupId><artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
